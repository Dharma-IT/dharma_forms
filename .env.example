# Server-only credentials. Never prefix these with VITE_.
BIGIN_CLIENT_ID=
BIGIN_CLIENT_SECRET=
BIGIN_REFRESH_TOKEN=
BIGIN_ACCOUNTS_URL=https://accounts.zoho.com
BIGIN_API_DOMAIN=

# Comma-separated exact frontend origins allowed to submit (server-only).
# Set this to your actual Vercel production URL in Render after creating the project.
ALLOWED_ORIGINS=

# Required server-only management PIN (4-12 digits). No default.
MANAGE_TEAM_PIN=
# PostgreSQL connection string for persistent team settings on Render.
DATABASE_URL=
