{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/stage", "headers": [{ "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://dharma-salestool.vercel.app" }] },
    { "source": "/stage/", "headers": [{ "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://dharma-salestool.vercel.app" }] }
  ],
  "rewrites": [
    { "source": "/deals", "destination": "/index.html" },
    { "source": "/deals/", "destination": "/index.html" },
    { "source": "/stage", "destination": "/index.html" },
    { "source": "/stage/", "destination": "/index.html" },
    { "source": "/migration", "destination": "/index.html" },
    { "source": "/migration/", "destination": "/index.html" },
    { "source": "/calendar", "destination": "/index.html" },
    { "source": "/calendar/", "destination": "/index.html" },
    { "source": "/manage-team", "destination": "/index.html" },
    { "source": "/manage-team/", "destination": "/index.html" },
    {
      "source": "/api/:path*",
      "destination": "https://dharma-forms.onrender.com/api/:path*"
    }
  ]
}

