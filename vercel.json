{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/manage-team", "destination": "/index.html" },
    { "source": "/manage-team/", "destination": "/index.html" },
    {
      "source": "/api/:path*",
      "destination": "https://dharma-forms.onrender.com/api/:path*"
    }
  ]
}
